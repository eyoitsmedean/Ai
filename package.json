{
  "name": "red-letter-advisor",
  "version": "1.0.0",
  "description": "A chatbot that responds with guidance from the words of Jesus Christ as recorded in the four Gospels",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "spoken": "node scripts/build-spoken.js && node scripts/bundle-advisor.js",
    "advisor": "node scripts/bundle-advisor.js",
    "eval:device": "EVAL_DEVICE=1 node scripts/eval-advisor.js",
    "icons": "python3 scripts/make-icons.py",
    "smoke": "node scripts/smoke.js",
    "qa": "node scripts/qa-browser.js",
    "eval": "node scripts/eval-advisor.js",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "puppeteer-core": "^25.9.0"
  }
}
