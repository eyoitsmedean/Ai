{
  "name": "red-letter-advisor",
  "version": "1.0.0",
  "description": "A chatbot that responds with guidance from the words of Jesus Christ as recorded in the four Gospels",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "spoken": "node scripts/build-spoken.js",
    "icons": "python3 scripts/make-icons.py",
    "smoke": "node scripts/smoke.js",
    "qa": "node scripts/qa-browser.js",
    "eval:crisis": "node scripts/eval-crisis.js",
    "eval:advisor": "node scripts/eval-advisor.js",
    "build:live": "node scripts/build-live-advisor.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0"
  }
}
