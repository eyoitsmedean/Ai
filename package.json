{
  "name": "red-letter-advisor",
  "version": "1.1.0",
  "description": "Red Letter Advisor \u2014 daily guidance, encouragement, and chat grounded only in the direct words of Jesus (WEB-verified).",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/smoke.js",
    "smoke": "node scripts/smoke.js",
    "test:unit": "node --test test/*.test.js",
    "verify:corpus": "node scripts/verify-corpus.js",
    "icons": "python3 scripts/generate-icons.py",
    "eval": "node scripts/eval.js",
    "eval:strict": "node scripts/eval.js --strict",
    "ui-check": "node scripts/ui-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  }
}
