# Required for live AI generation. Without it, curated KJV pages and a
# retrieved Advisor letter still load.
ANTHROPIC_API_KEY=your_api_key_here

# Optional alternative to the API key
# ANTHROPIC_AUTH_TOKEN=

# Optional
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low            # output_config.effort: low | medium | high
# PORT=3000
# ALLOWED_ORIGINS=https://eyoitsmedean.github.io   # comma-separated; only for a static front end
# API_ACCESS_KEY=                 # requires X-Api-Key on /api/*; the browser app never sends one
