# Required for live AI generation. Without it, curated Gospel pages still load.
ANTHROPIC_API_KEY=your_api_key_here

# Optional alternative to the API key
# ANTHROPIC_AUTH_TOKEN=

# Optional
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low
# PORT=3000
# API_ACCESS_KEY=
# TRUST_PROXY=1
# MODEL_TIMEOUT_MS=45000
# CHAT_MAX_TOKENS=2400
# STRUCTURED_MAX_TOKENS=2000
