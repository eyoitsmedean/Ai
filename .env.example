# Copy this file to .env and fill in your API key
ANTHROPIC_API_KEY=your_api_key_here
PORT=3000

# Web Push (morning red letter). Optional: if omitted, keys are generated once and
# persisted to data/push-store.json. Set them explicitly in production so subscriptions
# survive redeploys on ephemeral filesystems.  Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_STORE=/data/push-store.json
