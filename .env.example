# Pick a model. Without a matching key, curated Gospel pages still load.
#   claude-opus-5   (Anthropic, default)
#   gpt-6-astra     (OpenAI)
# MODEL=claude-opus-5

# Required for Claude models
ANTHROPIC_API_KEY=your_api_key_here
# Optional alternative to the API key
# ANTHROPIC_AUTH_TOKEN=

# Required for GPT models
# OPENAI_API_KEY=
# Optional: none | minimal | low | medium | high | xhigh
# OPENAI_REASONING_EFFORT=
# OPENAI_BASE_URL=

# Optional
# PORT=3000
# API_ACCESS_KEY=
