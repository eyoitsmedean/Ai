# Required for live AI generation. Without it, curated Gospel pages still load
# and the Advisor writes a retrieved, corpus-verified letter.
ANTHROPIC_API_KEY=your_api_key_here

# Optional alternative to the API key
# ANTHROPIC_AUTH_TOKEN=

# Optional
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production
# TRUST_PROXY=1
# API_ACCESS_KEY=
